# Copy this file to .env and fill it in. (On Windows, make sure it's saved as ".env", not ".env.txt".)

# Claude API key (https://platform.claude.com). Without it the paper still prints,
# but as raw "wire copy" excerpts instead of written articles.
ANTHROPIC_API_KEY=

# Password for the hidden /admin page (print editions, switch daily auto-print on/off).
# Leave empty to disable the admin page.
ADMIN_PASSWORD=

# Model for the editor and the writers. Default Claude Sonnet 5.5 (~$0.50 per edition).
# claude-opus-5-5 writes a little better at about twice the price; claude-haiku-5-5 costs pennies.
# CLAUDE_MODEL=claude-sonnet-5-5
# EDITOR_EFFORT=medium
# WRITER_EFFORT=low

# Defaults for daily auto-print. Once you change them in /admin, /admin's values win.
# AUTO_GENERATE=true
# PRINT_TIME=06:00
# TZ_NAME=Europe/Zurich

# Print today's edition on server start if it doesn't exist yet (catches up after downtime).
# CATCH_UP_ON_START=true

# Paper size and freshness window.
# MAX_ARTICLES=18
# MAX_BRIEFS=12
# LOOKBACK_HOURS=36

# PAPER_NAME=The Para News
# PORT=3000

# AI_MODE=off   # force raw wire copy even when a key is set
